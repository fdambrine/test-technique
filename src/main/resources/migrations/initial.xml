<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
<changeSet id="bootstrapDatabase" author="fdambrine">
    <createTable tableName="drivers">
        <column name="driverId" autoIncrement="true" type="java.sql.Types.Integer" >
            <constraints primaryKey="true" primaryKeyName="drivers_pk" nullable="false"/>
        </column>
        <column name="number" type="java.sql.Types.Integer">
            <constraints nullable="false"/>
        </column>
        <column name="forename" type="java.sql.Types.VARCHAR(255)"/>
        <column name="surname" type="java.sql.Types.VARCHAR(255)"/>
        <column name="nationality" type="java.sql.Types.VARCHAR(255)"/>
    </createTable>
    <createTable tableName="constructors">
        <column name="constructorId" autoIncrement="true" type="java.sql.Types.Integer" >
            <constraints primaryKey="true" primaryKeyName="constructor_pk" nullable="false"/>
        </column>
        <column name="name" type="java.sql.Types.VARCHAR(255)"/>
        <column name="nationality" type="java.sql.Types.VARCHAR(255)"/>
    </createTable>
    <createTable tableName="season">
        <column name="seasonId" autoIncrement="true" type="java.sql.Types.Integer" >
            <constraints primaryKey="true" primaryKeyName="season_pk" nullable="false"/>
        </column>
        <column type="java.sql.Types.VARCHAR(10)" name="name">
            <constraints unique="true" nullable="false" uniqueConstraintName="only_one_season"/>
        </column>

    </createTable>
    <createTable tableName="constructor_crew">
        <column name="id" autoIncrement="true" type="java.sql.Types.Integer" >
            <constraints primaryKey="true" primaryKeyName="crew_pk" nullable="false"/>
        </column>
        <column name="constructorId" type="java.sql.Types.Integer">
            <constraints foreignKeyName="fk_constructor" referencedTableName="constructors" referencedColumnNames="constructorId"/>
        </column>
        <column name="driverId" type="java.sql.Types.Integer">
            <constraints foreignKeyName="fk_driver" referencedTableName="drivers" referencedColumnNames="constructorId"/>
        </column>
        <column name="seasonId" type="java.sql.Types.Integer">
            <constraints foreignKeyName="fk_season" referencedTableName="season" referencedColumnNames="seasonId"/>
        </column>
    </createTable>
</changeSet>
</databaseChangeLog>